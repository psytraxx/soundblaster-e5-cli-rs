;; Register Dlls **********************************************************************************

[SfxFx.RegisterDlls.ntx86]
11,,KSUSBAPO32.dll,1
11,,KSUSBPPLD32.dll,1
11,,KSUSBSPI32.dll,1

[SfxFxAPOChain.RegisterDlls.ntx86]
11,,KSUSBWrap32.dll,1 
11,,KSUSBDGFX32.dll,1

;[SfxFxMalc.RegisterDlls.ntx86]
;11,,KsUSBMalc32.dll,1

[SfxFx.RegisterDlls.ntamd64]
16425,,KSUSBAPO32.dll,1
11,,KSUSBAPO64.dll,1
11,,KSUSBPPLD64.dll,1
16425,,KSUSBSPI32.dll,1
11,,KSUSBSPI64.dll,1

[SfxFxAPOChain.RegisterDlls.ntamd64]
11,,KSUSBWrap64.dll,1  
11,,KSUSBDGFX64.dll,1

[SysFx1580.AddReg]
HKR,"FX\\0",%PKEY_DisplayName%,,%SYSFX_FriendlyName%
HKR,"FX\\0",%PKEY_SYSFX_PreMixClsid%,,%SYSFX_PREMIX_CLSID_KS%
HKR,"FX\\0",%PKEY_SYSFX_PostMixClsid%,,%SYSFX_POSTMIX_CLSID_KS%
;HKR,"FX\\0",%PKEY_SYSFX_UiClsid%,,%SYSFX_UI_CLSID_KS%
HKR,"FX\\0",%PKEY_SYSFX_Association%,,%KSNODETYPE_SPEAKER%

HKR,"FX\\1",%PKEY_DisplayName%,,%SYSFX_FriendlyName%
HKR,"FX\\1",%PKEY_SYSFX_PreMixClsid%,,%SYSFX_PREMIX_CLSID_KS%
HKR,"FX\\1",%PKEY_SYSFX_PostMixClsid%,,%SYSFX_POSTMIX_CLSID_KS%
;HKR,"FX\\1",%PKEY_SYSFX_UiClsid%,,%SYSFX_UI_CLSID_KS%
HKR,"FX\\1",%PKEY_SYSFX_Association%,,%KSNODETYPE_SPDIF_INTERFACE%

HKR,"FX\\2",%PKEY_DisplayName%,,%SYSFX_FriendlyName%
HKR,"FX\\2",%PKEY_SYSFX_PreMixClsid%,,%SYSFX_PREMIX_CLSID_KS%
HKR,"FX\\2",%PKEY_SYSFX_PostMixClsid%,,%SYSFX_POSTMIX_CLSID_KS%
;HKR,"FX\\2",%PKEY_SYSFX_UiClsid%,,%MS_FX_UI_CLSID%
HKR,"FX\\2",%PKEY_SYSFX_Association%,,%KSNODETYPE_PROCESSING_MICROPHONE_ARRAY%

HKR,"FX\\3",%PKEY_DisplayName%,,%MS_FX_FriendlyName%
HKR,"FX\\3",%PKEY_SYSFX_PreMixClsid%,,%MS_FX_PREMIX_CLSID%
HKR,"FX\\3",%PKEY_SYSFX_PostMixClsid%,,%MS_FX_POSTMIX_CLSID%
