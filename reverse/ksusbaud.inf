;; SB1580 specific *****************************************************************************
[SB1580.Interface.Wave]
AddReg=SB1580.Interface.Wave.AddReg,SysFx1580.AddReg,SB1580.SysEP.AddReg
DelReg=SysFx.DelReg

[SB1580.Interface.Wave.6.3]
AddReg=SB1580.Interface.Wave.AddReg,SysFx1580.6.3.AddReg,SB1580.SysEP.AddReg
DelReg=SysFx.DelReg

[SB1580.Interface.Wave.AddReg]
HKR,,FriendlyName,,%SB1580.Wave.szPname%
HKR,,CurveType,1,01,00,00,00
HKR,,CLSID,,%Proxy.CLSID%

[SB1580HW.AddReg]
HKR,,FriendlyName,,%SB1580.DeviceDesc%

[SB1580.AddReg]
HKR,Drivers\wave\wdmaud.drv, Description,,%SB1580.DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%SB1580.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%SB1580.DeviceDesc%
HKR,Drivers\aux\wdmaud.drv,  Description,,%SB1580.DeviceDesc%

HKR,"Product",Name,,%SB1580.Product%
HKR,"DevName",%WaveOutDevName%,,%SB1580.Wave.szPname%
HKR,"DevName",%WaveInDevName%,,%SB1580.Wave.szPname%
HKR,"DevName",%MixerDevName%,,%SB1580.Topology.szPname%
;; Copy friendly names to a location the driver knows
HKLM,%DevInfoSB1580%,%WaveOutDevName%,,%SB1580.Wave.szPname%
HKLM,%DevInfoSB1580%,%WaveInDevName%,,%SB1580.Wave.szPname%
HKLM,%DevInfoSB1580%,%MixerDevName%,,%SB1580.Topology.szPname%

