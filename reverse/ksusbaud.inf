;; SB1580 specific x86 install*****************************************************************************

[SB1580_Device.ntx86.CoInstallers]
CopyFiles=CoInst.CopyList,APOIM.CopyList.ntx86
AddReg=COINST.AddReg

[SB1580_Device.ntx86]
Include=ks.inf, wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration,mssysfx.CopyFilesAndRegister
CopyFiles=KSAUD.CopyList,RegIni.CopyList,SfxFx.CopyList.ntx86,APOIMConfig.CopyList,AudioBrand.SBX.CopyList,SfxFxAPOChain.CopyList.ntx86
AddReg=KSAUD.AddReg,SBAVMon.AddReg,SB1580.AddReg,KS_NAMES.AddReg,AudioBrand.SBX.AddReg
RegisterDlls=SfxFx.RegisterDlls.ntx86,SfxFxAPOChain.RegisterDlls.ntx86

[SB1580_Device.ntx86.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_GLOBAL%,        SB1580.Interface.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_GLOBAL%,       SB1580.Interface.Wave
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_GLOBAL%,      SB1580.Interface.Wave

[SB1580_Device.ntx86.Services]
AddService = KsUSBaud, 0x00000002, KSAUD_Service_Inst

[SB1580_Device.ntx86.HW]
AddReg=SB1580HW.AddReg
DelReg=KSAUDHW.DelReg

